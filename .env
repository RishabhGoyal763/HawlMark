# Application
APP_ENV=development
APP_NAME=GST Billing Application
DEBUG=true

# MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=@Rishi2661
MYSQL_DATABASE=gst_billing

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:8000

# GST Provider
GST_PROVIDER_TYPE=mock
GST_PROVIDER_API_KEY=
GST_PROVIDER_BASE_URL=
